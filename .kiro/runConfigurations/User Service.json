{
  "name": "User Service",
  "type": "SpringBoot",
  "factoryName": "Spring Boot",
  "module": "crm-user-service",
  "springBootMainClass": "com.pk.crm.user.UserServiceApplication",
  "workingDirectory": "$PROJECT_DIR$/crm-backend/crm-user-service",
  "jvmArgs": "-Xmx1024m -Xms256m --enable-preview --add-opens=java.base/java.lang=ALL-UNNAMED",
  "programArgs": "",
  "environmentVariables": {
    "SPRING_PROFILES_ACTIVE": "dev"
  },
  "vmOptions": "--enable-preview",
  "alternativeJrePath": "",
  "enableDebug": true,
  "debugPort": 5006,
  "updateActionUpdatePolicy": "UpdateResources",
  "frameDeactivationUpdatePolicy": "UpdateResources"
}